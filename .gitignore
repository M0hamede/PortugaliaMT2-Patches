# Ignorar os ficheiros do cliente Metin2
/*

# Permitir ficheiros de controlo do GitHub
!/.gitignore
!/README.md

# Permitir scripts e indice do patcher
!/patcher/
!/patcher/**

# Ignorar ficheiros temporarios do Python
/patcher/**/__pycache__/
/patcher/**/*.pyc
/patcher/**/*.pyo

# Permitir configuracoes do GitHub
!/.github/
!/.github/**